rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdminEmail() {
      return isVerifiedUser() && request.auth.token.email == 'bajajseapee@gmail.com';
    }

    function isAdmin() {
      return isVerifiedUser() && (
        isBootstrappedAdminEmail() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Entity Validation Blueprints
    function isValidInquiry(data) {
      return data.keys().hasAll([
        'authorId',
        'name',
        'email',
        'projectType',
        'message',
        'status',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'authorId',
        'name',
        'email',
        'projectType',
        'message',
        'status',
        'createdAt',
        'updatedAt'
      ]) &&
      data.authorId is string &&
      data.authorId.size() >= 1 &&
      data.authorId.size() <= 128 &&
      data.authorId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.name is string &&
      data.name.size() >= 1 &&
      data.name.size() <= 120 &&
      data.email is string &&
      data.email.size() >= 3 &&
      data.email.size() <= 160 &&
      data.projectType is string &&
      data.projectType.size() >= 1 &&
      data.projectType.size() <= 80 &&
      data.projectType in [
        'SEO Content Strategy',
        'B2B & Research Synthesis',
        'Website & Conversion Copy',
        'Editorial Calendar Governance',
        'Thought Leadership & Social',
        'Full-Time / Contract Role',
        'Other Inquiries'
      ] &&
      data.message is string &&
      data.message.size() >= 15 &&
      data.message.size() <= 3000 &&
      data.status is string &&
      data.status.size() >= 3 &&
      data.status.size() <= 20 &&
      data.status in ['new', 'in_review', 'replied', 'closed'] &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidPortfolioItem(data) {
      return data.keys().hasAll([
        'authorId',
        'title',
        'category',
        'summary',
        'impactMetric',
        'externalUrl',
        'published',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'authorId',
        'title',
        'category',
        'summary',
        'impactMetric',
        'externalUrl',
        'published',
        'createdAt',
        'updatedAt'
      ]) &&
      data.authorId is string &&
      data.authorId.size() >= 1 &&
      data.authorId.size() <= 128 &&
      data.authorId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.title is string &&
      data.title.size() >= 3 &&
      data.title.size() <= 160 &&
      data.category is string &&
      data.category.size() >= 2 &&
      data.category.size() <= 40 &&
      data.category in [
        'SEO & Content',
        'B2B',
        'Research',
        'Content Strategy',
        'Creative'
      ] &&
      data.summary is string &&
      data.summary.size() >= 10 &&
      data.summary.size() <= 600 &&
      data.impactMetric is string &&
      data.impactMetric.size() >= 2 &&
      data.impactMetric.size() <= 120 &&
      data.externalUrl is string &&
      data.externalUrl.size() >= 0 &&
      data.externalUrl.size() <= 500 &&
      data.published is bool &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidAdminRecord(data) {
      return data.keys().hasAll(['uid', 'role', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'role', 'createdAt']) &&
        data.uid is string &&
        data.uid.size() >= 1 &&
        data.uid.size() <= 128 &&
        data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.uid == request.auth.uid &&
        data.role is string &&
        data.role.size() >= 5 &&
        data.role.size() <= 10 &&
        data.role == 'admin' &&
        data.createdAt is timestamp;
    }

    // Collection: /inquiries/{inquiryId}
    match /inquiries/{inquiryId} {
      allow get: if isVerifiedUser() && isValidId(inquiryId) && (
        existing().authorId == request.auth.uid || isAdmin()
      );

      // Zero-DB-lookup list rule enforcing owner or bootstrapped admin
      allow list: if isVerifiedUser() && (
        resource.data.authorId == request.auth.uid || isBootstrappedAdminEmail()
      );

      allow create: if isVerifiedUser() &&
        isValidId(inquiryId) &&
        isValidInquiry(incoming()) &&
        incoming().authorId == request.auth.uid &&
        incoming().status == 'new' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isVerifiedUser() &&
        isValidId(inquiryId) &&
        isValidInquiry(incoming()) &&
        (existing().status != 'closed' || isAdmin()) &&
        incoming().authorId == existing().authorId &&
        incoming().createdAt == existing().createdAt &&
        incoming().email == existing().email &&
        incoming().name == existing().name &&
        incoming().updatedAt == request.time && (
          // Action 1: Owner edits message or projectType while inquiry is still 'new'
          (
            existing().authorId == request.auth.uid &&
            existing().status == 'new' &&
            incoming().status == 'new' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['message', 'projectType', 'updatedAt'])
          ) ||
          // Action 2: Admin updates workflow status
          (
            isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
        );

      allow delete: if isVerifiedUser() && isValidId(inquiryId) && (
        isAdmin() || (existing().authorId == request.auth.uid && existing().status == 'new')
      );
    }

    // Collection: /portfolioItems/{itemId}
    match /portfolioItems/{itemId} {
      allow get: if isValidId(itemId) && (
        existing().published == true || isAdmin()
      );

      // Zero-DB-lookup list rule enforcing published status or bootstrapped admin
      allow list: if resource.data.published == true || isBootstrappedAdminEmail();

      allow create: if isVerifiedUser() &&
        isValidId(itemId) &&
        isValidPortfolioItem(incoming()) &&
        incoming().authorId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin();

      allow update: if isVerifiedUser() &&
        isValidId(itemId) &&
        isValidPortfolioItem(incoming()) &&
        incoming().authorId == existing().authorId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        isAdmin() && (
          // Action: Admin updates portfolio item content or publication visibility
          incoming().diff(existing()).affectedKeys().hasOnly([
            'title',
            'category',
            'summary',
            'impactMetric',
            'externalUrl',
            'published',
            'updatedAt'
          ])
        );

      allow delete: if isVerifiedUser() && isValidId(itemId) && isAdmin();
    }

    // Collection: /admins/{adminId}
    match /admins/{adminId} {
      allow get: if isVerifiedUser() && isValidId(adminId) && (
        adminId == request.auth.uid || isAdmin()
      );

      allow create: if isVerifiedUser() &&
        isValidId(adminId) &&
        adminId == request.auth.uid &&
        isValidAdminRecord(incoming()) &&
        incoming().createdAt == request.time &&
        isBootstrappedAdminEmail();

      allow update, delete, list: if false;
    }
  }
}
